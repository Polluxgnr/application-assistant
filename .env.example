# Copy to .env and fill in. Never commit .env.

# --- Postgres (n8n's own database + the project database "assistant") ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
ASSISTANT_DB=assistant

# --- n8n ---
# 32+ random characters; generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=Europe/Paris
N8N_EDITOR_BASE_URL=http://localhost:5678

# --- Discord (Developer Portal > General Information) ---
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ADMIN_CHANNEL_ID=

# --- Google Docs / Drive ---
GOOGLE_CV_TEMPLATE_ID=
GOOGLE_DRIVE_FOLDER_ID=

# --- Secrets you paste yourself (never committed). scripts/import.sh loads them into n8n. ---
# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=
# openrouter.ai > Keys > Create key
OPENROUTER_API_KEY=
# Google Cloud > Clients > your OAuth client (Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
