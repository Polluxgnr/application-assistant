    {
      "parameters": {
        "jsCode": "// Verifies Discord's Ed25519 signature and flattens the interaction payload.\nconst crypto = require('crypto');\nconst PUBLIC_KEY = $env.DISCORD_PUBLIC_KEY; // Developer Portal > General Information, set in .env\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst sig = headers['x-signature-ed25519'];\nconst ts = headers['x-signature-timestamp'];\n\nlet raw = '';\nif (item.binary && Object.keys(item.binary).length) {\n  const key = Object.keys(item.binary)[0];\n  raw = (await this.helpers.getBinaryDataBuffer(0, key)).toString('utf8');\n} else {\n  raw = JSON.stringify(item.json.body || {});\n}\n\nlet valid = false;\ntry {\n  const pub = crypto.createPublicKey({\n    key: Buffer.concat([Buffer.from('302a300506032b6570032100', 'hex'), Buffer.from(PUBLIC_KEY, 'hex')]),\n    format: 'der', type: 'spki',\n  });\n  valid = !!sig && !!ts && crypto.verify(null, Buffer.from(ts + raw), pub, Buffer.from(sig, 'hex'));\n} catch (e) { valid = false; }\n\nlet body = {};\ntry { body = JSON.parse(raw); } catch (e) { body = item.json.body || {}; }\n\nconst opts = {};\nfor (const o of (body.data?.options || [])) opts[o.name] = o.value;\nconst attachment = opts.file ? (body.data?.resolved?.attachments?.[opts.file] || null) : null;\nconst user = body.member?.user || body.user || {};\n\nreturn [{ json: {\n  valid,\n  type: Number(body.type || 0),\n  command: body.data?.name || '',\n  user_id: String(user.id || ''),\n  username: user.global_name || user.username || '',\n  app_id: String(body.application_id || ''),\n  token: body.token || '',\n  url: String(opts.url || '').trim(),\n  text: String(opts.text || '').trim(),\n  attachment,\n} }];"
      },
