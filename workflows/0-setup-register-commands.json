    {
      "parameters": {
        "method": "PUT",
        "url": "=https://discord.com/api/v10/applications/{{ $json.app_id }}/guilds/{{ $json.guild_id }}/commands",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "[\n  {\n    \"name\": \"help\",\n    \"description\": \"How to use the Application Assistant\",\n    \"type\": 1\n  },\n  {\n    \"name\": \"cv\",\n    \"description\": \"Upload your base CV (PDF)\",\n    \"type\": 1,\n    \"options\": [\n      {\n        \"type\": 11,\n        \"name\": \"file\",\n        \"description\": \"Your CV as a PDF\",\n        \"required\": true\n      }\n    ]\n  },\n  {\n    \"name\": \"job\",\n    \"description\": \"Analyze a job offer (link or pasted text)\",\n    \"type\": 1,\n    \"options\": [\n      {\n        \"type\": 3,\n        \"name\": \"url\",\n        \"description\": \"Link to the job offer\",\n        \"required\": false\n      },\n      {\n        \"type\": 3,\n        \"name\": \"text\",\n        \"description\": \"Or paste the offer text\",\n        \"required\": false\n      }\n    ]\n  },\n  {\n    \"name\": \"answer\",\n    \"description\": \"Answer the bot's question about a skill\",\n    \"type\": 1,\n    \"options\": [\n      {\n        \"type\": 3,\n        \"name\": \"text\",\n        \"description\": \"Your answer\",\n        \"required\": true\n      }\n    ]\n  }\n]",
        "options": {}
      },
