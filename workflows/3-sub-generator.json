    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 'base_cv' AS kind, base_cv AS value FROM profiles WHERE user_id = $1\nUNION ALL\nSELECT 'cv_profile', cv_profile::text FROM profiles WHERE user_id = $1\nUNION ALL\nSELECT kind, value FROM facts WHERE user_id = $1;",
        "options": {
          "queryReplacement": "={{ [ $('Load Session').first().json.user_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1760,
        112
      ],
      "name": "DB: All My Facts",
      "id": "ebde486f-e446-48d1-be5a-3ed9a2f58602",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "postgres": {
          "id": "pgAssistantDb001",
          "name": "Assistant DB (Postgres)"
        }
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Load Session').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.kind);\nconst base = rows.find(r => r.kind === 'base_cv')?.value || '';\nconst facts = rows.filter(r => ['skill', 'experience', 'answer'].includes(r.kind)).map(r => '- ' + r.value);\nconst gaps = rows.filter(r => r.kind === 'gap').map(r => '- ' + r.value);\nlet master = base;\nif (facts.length) master += '\\n\\nADDITIONAL FACTS CONFIRMED BY THE CANDIDATE (true, may be used):\\n' + facts.join('\\n');\nif (gaps.length) master += '\\n\\nKNOWN GAPS (never claim these):\\n' + gaps.join('\\n');\n// requirements the Analyzer could not find on the CV: only usable if a confirmed fact covers them\nlet unconfirmed = [];\ntry { unconfirmed = JSON.parse(ctx.session?.missing_json || '[]'); } catch (e) {}\nif (unconfirmed.length) master += '\\n\\nJOB REQUIREMENTS NOT FOUND ON THE CV (never claim these unless an ADDITIONAL FACT above explicitly confirms it):\\n' + unconfirmed.map(x => '- ' + x).join('\\n');\nreturn [{ json: { ...ctx, master_resume: master } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        112
      ],
      "name": "Build Profile",
      "id": "bc52b03e-3aa3-4101-bb1c-332a206ad116"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert resume writer specializing in ATS-optimized, achievement-focused resumes. Tailor the candidate's resume content for one specific job while staying strictly factual.\n\n## INPUT DATA\n**Master Resume (base CV + facts the candidate confirmed in chat):**\n{{ $json.master_resume }}\n\n**Target Job:**\n- Company: {{ $json.offer.company }}\n- Role: {{ $json.offer.role_title }}\n- Key requirements: {{ ($json.offer.requirements || []).join(', ') }}\n- Full Description: {{ $json.job_text }}\n\n## YOUR TASK\nRewrite ONLY these five sections so they fit this job. Everything else (dates, titles, schools, languages, other experiences) is fixed in a template and must not be touched.\n1. SUMMARY: 2-3 lines (max 55 words) positioning the candidate for this role, built from real facts.\n2. DIGIMOBEE_BULLETS: 2-3 bullets about the Digimobee experience.\n3. ENEDIS_BULLETS: 2 bullets about the Enedis experience.\n4. ESSEC_ECON_BULLETS: 2 bullets about the ESSEC economics experience.\n5. SKILLS: one comma-separated line (max 330 characters) with the skills that best match the job, most relevant first. Confirmed facts from chat may be included.\n\n## LANGUAGE\nWrite everything in the language of the job description ({{ $json.offer.language === 'fr' ? 'French' : 'English' }}).\n\n## RULES\n- DO reorder, emphasize and reword existing achievements; reuse exact keywords from the job description where they genuinely apply.\n- DO start each bullet with a strong action verb. Max 22 words per bullet.\n- DO NOT fabricate experience, skills, tools, metrics or numbers. Only use numbers present in the master resume.\n- DO NOT claim anything listed under KNOWN GAPS or JOB REQUIREMENTS NOT FOUND ON THE CV, unless an ADDITIONAL FACT explicitly confirms it.\n- SKILLS may only contain skills, tools and languages that appear in the master resume or the ADDITIONAL FACTS. Never copy a skill from the job description that the candidate has not shown.\n- Keep each bullet about its own experience: only attach a tool or skill to an experience if the master resume links them there.\n- DO NOT change employment dates or job titles. No commentary like \"directly transferable to...\".\n- Plain text only: no markdown, no \"#\", \"**\", dashes or bullet symbols. Separate bullets with a newline.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        2208,
        112
      ],
      "name": "AI: Tailor CV",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "id": "d42aa878-82fc-4577-8113-e9bafbf8bab4",
      "onError": "continueErrorOutput"
    },
