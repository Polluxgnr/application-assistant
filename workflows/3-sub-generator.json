    {
      "parameters": {
        "promptType": "define",
        "text": "=Extract the facts the candidate just confirmed about themselves.\n\nQuestion the bot asked: {{ $json.question }}\nCandidate's answer: {{ $json.answer }}\n\nReturn a list of facts. kind is \"skill\" (a skill/tool they have, include short context, e.g. \"Agile (Scrum) — used during graduation project\"), \"experience\" (a concrete project or achievement), or \"gap\" (something they clearly do NOT have, e.g. \"No experience with Tableau\"). Only use what the answer says. Never invent.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
