    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"SUMMARY\": \"...\",\n  \"DIGIMOBEE_BULLETS\": \"bullet one\\nbullet two\",\n  \"ENEDIS_BULLETS\": \"bullet one\\nbullet two\",\n  \"ESSEC_ECON_BULLETS\": \"bullet one\\nbullet two\",\n  \"SKILLS\": \"Python, SQL, ...\"\n}"
