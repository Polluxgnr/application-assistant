    {
      "parameters": {
        "jsCode": "const ctx = $('Load Session').first().json;\nconst facts = ($input.first().json.output?.facts || []).filter(f => f && f.value);\nconst rows = facts.length ? facts : [{ kind: 'answer', value: ctx.answer }];\nreturn rows.map(f => ({ json: { user_id: ctx.user_id, kind: f.kind || 'answer', value: String(f.value).slice(0, 1000) } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        -16
      ],
      "name": "Split Facts",
      "id": "5287e5cd-e7c3-484c-b6f7-16f841e9242c"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO facts (user_id, kind, value, source)\nVALUES ($1, CASE WHEN $2 IN ('skill', 'experience', 'gap') THEN $2 ELSE 'answer' END, $3, 'answer')\nON CONFLICT (user_id, kind, value_hash) DO NOTHING\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.user_id, $json.kind, $json.value ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
