      "name": "User to notify?",
      "id": "80dd420c-c3ad-4769-bedb-3a96b6db31c1"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://discord.com/api/v10/webhooks/{{ $('DB: Find Run').first().json.app_id }}/{{ $('DB: Find Run').first().json.token }}/messages/@original",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: String('⚠️ Something went wrong on my side (step: ' + $('Format Error').first().json.failed_node + '). The details were sent to the admin. Please try again in a minute — if it was a job link, try `/job text:<paste the offer>`.').slice(0, 1990) }) }}",
        "options": {
          "timeout": 15000
        }
      },
