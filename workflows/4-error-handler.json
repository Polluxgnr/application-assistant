{
  "name": "4. Error Handler",
  "nodes": [
    {
      "parameters": {
        "content": "## Error workflow\nFires when a run of the Main workflow still fails after the node retries.\n→ me: failed node + error on my admin channel\n→ user: *something went wrong* (found through the `runs` table by execution id)",
        "height": 180,
        "width": 1400,
        "color": 3
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -48,
        -224
      ],
      "name": "E1",
      "id": "627655bb-8c48-403e-a4ee-06ad1fe2f894"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        112
      ],
      "name": "Error Trigger",
      "id": "f715c4d4-1eeb-46ed-bb07-f26aa9569823"
    },
    {
      "parameters": {
        "jsCode": "const ADMIN_CHANNEL_ID = '1559918396273852446';\nconst ex = $json.execution || {};\nconst msg = [\n  '🛑 **' + ($json.workflow?.name || 'Workflow') + '** failed',\n  'Node: `' + (ex.lastNodeExecuted || '?') + '`',\n  'Error: ' + String(ex.error?.message || 'unknown').slice(0, 800),\n  ex.url ? 'Execution: ' + ex.url : 'Execution id: ' + ex.id,\n].join('\\n');\n// Main fails on its Run Analyzer / Run Generator node when a sub-workflow failed: that sub-workflow already alerted me\nconst already_alerted = /^Run (Analyzer|Generator)/.test(ex.lastNodeExecuted || '');\nreturn [{ json: { admin_channel_id: ADMIN_CHANNEL_ID, admin_message: msg, execution_id: String(ex.id || ''), failed_node: ex.lastNodeExecuted || '', already_alerted } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        112
      ],
      "name": "Format Error",
      "id": "b003d833-663a-48cf-b997-d25063d4bec1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://discord.com/api/v10/channels/{{ $json.admin_channel_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.admin_message.slice(0, 1990) }) }}",
        "options": {}
      },
