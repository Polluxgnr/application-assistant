  "name": "4. Error Handler",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Error workflow\nFires when a run of the Main workflow still fails after the node retries.\n→ me: failed node + error on my admin channel\n→ user: *something went wrong* (found through the `runs` table by execution id)",
        "height": 180,
        "width": 1400,
        "color": 3
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -48,
        -224
      ],
      "name": "E1",
      "id": "627655bb-8c48-403e-a4ee-06ad1fe2f894"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        112
      ],
      "name": "Error Trigger",
      "id": "f715c4d4-1eeb-46ed-bb07-f26aa9569823"
    },
    {
      "parameters": {
        "jsCode": "const ADMIN_CHANNEL_ID = $env.DISCORD_ADMIN_CHANNEL_ID; // set in .env\nconst ex = $json.execution || {};\nconst msg = [\n  '🛑 **' + ($json.workflow?.name || 'Workflow') + '** failed',\n  'Node: `' + (ex.lastNodeExecuted || '?') + '`',\n  'Error: ' + String(ex.error?.message || 'unknown').slice(0, 800),\n  ex.url ? 'Execution: ' + ex.url : 'Execution id: ' + ex.id,\n].join('\\n');\n// Main fails on its Run Analyzer / Run Generator node when a sub-workflow failed: that sub-workflow already alerted me\nconst already_alerted = /^Run (Analyzer|Generator)/.test(ex.lastNodeExecuted || '');\nreturn [{ json: { admin_channel_id: ADMIN_CHANNEL_ID, admin_message: msg, execution_id: String(ex.id || ''), failed_node: ex.lastNodeExecuted || '', already_alerted } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        112
      ],
      "name": "Format Error",
      "id": "b003d833-663a-48cf-b997-d25063d4bec1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://discord.com/api/v10/channels/{{ $json.admin_channel_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.admin_message.slice(0, 1990) }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        32
      ],
      "name": "Discord: Alert Me",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "id": "5114d8f0-a8bf-4b42-98a1-4e0a24583a51",
      "credentials": {
        "httpHeaderAuth": {
          "id": "AOHwJRZXdD5IQR6Q",
          "name": "Discord Bot Auth"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT user_id, app_id, token, command FROM runs WHERE execution_id = $1;",
        "options": {
          "queryReplacement": "={{ [ $('Format Error').first().json.execution_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        896,
        112
      ],
      "name": "DB: Find Run",
      "id": "92b320b1-a80e-4fc7-82b3-fe176724904a",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "postgres": {
          "id": "pgAssistantDb001",
          "name": "Assistant DB (Postgres)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "e010b587-199e-400a-b10c-73a08037735d",
              "leftValue": "={{ !!$json.token }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
